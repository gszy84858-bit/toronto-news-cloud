  "business_topics": [
    {
      "label": "关税与贸易壁垒",
      "keywords": ["tariff", "tariffs", "trade war", "countertariff", "counter-tariff", "duty", "duties", "antidumping", "anti-dumping", "safeguard", "section 232", "section 301", "usmca", "cptpp", "world trade", "wto"],
      "advice": "关税直接推高进口成本与终端定价。先确认你主销品类的 HTS 编码是否在清单内，再决定是提前备货、改走第三国中转，还是把涨幅传导给售价。别等到报关时才发现利润被吃掉。"
    },
    {
      "label": "禁售与合规",
      "keywords": ["ban", "banned", "prohibited", "restricted", "import ban", "compliance", "recall", "safety standard", "certification", "labeling", "labelling", "packaging rule", "consumer product safety", "health canada approval", "ce mark", "ul certification"],
      "advice": "禁售与合规要求属于硬门槛，一旦生效Listing会被平台直接下架。查清生效日期，提前核对产品标签、认证与说明书是否达标，必要时先下架整改再补货。"
    },
    {
      "label": "加元汇率",
      "keywords": ["loonie", "canadian dollar", "currency", "exchange rate", "forex", "weaker dollar", "stronger dollar"],
      "advice": "加元走弱时，同样的人民币成本换回加元更少，等于利润被压缩；反之则利好。做定价时把汇率波动预留 3–5% 的缓冲，别按当日汇率倒推售价。"
    },
    {
      "label": "消费与零售数据",
      "keywords": ["retail sales", "consumer spending", "consumer price", "cpi", "holiday spending", "e-commerce", "online shopping", "foot traffic", "shopper", "buyer behaviour", "buyer behavior", "confidence index"],
      "advice": "消费数据是你判断备货量的直接依据。留意品类级的分项数字（而非总量）——总量增长但你的品类下滑，说明问题出在选品而不是大盘。"
    },
    {
      "label": "房地产与租金",
      "keywords": ["housing market", "home price", "house price", "rent", "rental", "vacancy rate", "mortgage rate", "real estate", "condo market", "average price"],
      "advice": "房市与租金影响本地家庭的可支配收入，进而影响家居、家装、日用类目的客单价。租金上涨通常先挤压低价日用消费，中高客单反而更抗压。"
    },
    {
      "label": "物流与航运",
      "keywords": ["canada post", "postal", "strike", "shipping", "freight", "container", "port", "vancouver port", "montreal port", "customs clearance", "border delay", "courier", "purolator", "ups", "fedex", "dhl", "last mile", "warehouse"],
      "advice": "物流中断会直接拖长妥投时效、拉高客诉率。旺季前把主发渠道和备用渠道都留好，尤其是小包类专线——罢工期间平台对时效的考核不会网开一面。"
    },
    {
      "label": "税制与征管",
      "keywords": ["gst", "hst", "sales tax", "tax", "taxation", "cra", "canada revenue", "corporate tax", "capital gains", "tax credit", "rebate", "duty free", "de minimis", "low value shipment", "import tax"],
      "advice": "税制与免税额度直接影响低客单价商品的竞争力。若低值包裹免税门槛被调整，低价直邮模式的首当其冲，需要提前测算走海外仓是否更划算。"
    },
    {
      "label": "中小企业与融资",
      "keywords": ["small business", "sme", "relief", "subsidy", "grant", "loan program", "bailout", "funding program", "ceba", "support program", "eligibility"],
      "advice": "政府纾困与补贴通常带营收或规模门槛，跨境卖家常因主体在境外而被排除。仔细读资格条款，若不符合，及早把重心放回渠道和成本的自身优化。"
    },
    {
      "label": "用工与人工成本",
      "keywords": ["minimum wage", "wage increase", "labour", "labor", "union", "hiring", "job cuts", "layoff", "employment", "work permit", "temporary foreign worker"],
      "advice": "人工成本上涨会传导到本地仓配、代运营和客服报价，间接抬高你的履约成本。签长约时把年度调价条款写清楚，别被单方面通知涨价。"
    },
